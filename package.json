{
  "name": "one-page-baby-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn two phones into a Wi-Fi baby monitor. A single static page — no app, no account.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "peer": "^1.0.2",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
